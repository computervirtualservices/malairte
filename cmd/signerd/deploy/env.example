# Copy to /etc/signerd/env (chmod 0640, owner root:signer). NEVER commit real
# values — this file is only a template; secrets live solely on the host.

# Private bind only. If CoinDock runs on a different host, bind the private
# interface (e.g. 10.0.0.5:8088) and firewall it to the app host — never 0.0.0.0.
SIGNER_BIND_ADDR=127.0.0.1:8088

# Bearer token; MUST equal CoinDock's COINDOCK_SIGNER_TOKEN. >= 24 chars.
# Generate: openssl rand -hex 32
SIGNER_TOKEN=

# BIP32 account xpub (PUBLIC) for m/44'/<mlrt>'/0'. Derived OFFLINE from the
# seed. Must derive the live reserve MCUFXHADb1n5WmdCYde6gDYWcspTL6uvHR in its
# tree. No private keys ever go here.
MLRT_ACCOUNT_XPUB=

# Base58 version byte: 50 = mainnet 'M', 111 = testnet 'm'.
MLRT_ADDRESS_VERSION=50

# Optional but STRONGLY recommended boot self-test: the service refuses to start
# unless deriving index N reproduces this exact address. Verify the address
# independently (MLRT wallet / malairte-cli) before setting it.
MLRT_SELFTEST_INDEX=
MLRT_SELFTEST_ADDRESS=
